OPENROUTER_API_KEY=sk-or-v1-...

# Cloudflare Stream — used by the viewer app to list/stream uploaded videos.
# Account ID is the 32-char hex in your dashboard URL: dash.cloudflare.com/<account_id>/...
# Token needs Stream:Read (a Stream-scoped API token is fine).
CLOUDFLARE_ACCOUNT_ID=...
CLOUDFLARE_STREAM_API_KEY=...
